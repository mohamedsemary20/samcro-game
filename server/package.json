{
  "name": "samkaro-server",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": { "node": ">=20.19" },
  "scripts": {
    "dev": "node --env-file=.env --import ./scripts/localTestQuestionPoolPreload.mjs --import tsx --watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node --env-file=.env dist/server/src/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "node --env-file=.env --import tsx prisma/seed.ts",
    "questions:validate": "node --import tsx scripts/questionBankCli.ts validate",
    "questions:import": "node --env-file=.env --import tsx scripts/questionBankCli.ts import",
    "questions:test-pool-import": "node --env-file=.env --import ./scripts/localTestQuestionPoolPreload.mjs --import tsx scripts/localTestQuestionPool.ts",
    "test:integration": "node --env-file=.env --import ./scripts/enableRoomIntegration.mjs ./node_modules/vitest/vitest.mjs run test/integration/roomLifecycle.integration.test.ts --maxWorkers=1"
  },
  "dependencies": {
    "@prisma/client": "^6.19.0",
    "cors": "^2.8.5",
    "express": "^5.1.0",
    "express-rate-limit": "^8.1.0",
    "helmet": "^8.1.0",
    "socket.io": "^4.8.1",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/node": "^24.7.2",
    "@types/ws": "^8.18.2",
    "prisma": "^6.19.0",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4",
    "ws": "^8.21.3"
  },
  "prisma": { "seed": "tsx prisma/seed.ts" }
}
